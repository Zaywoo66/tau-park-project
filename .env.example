# Copy to .env and replace both passwords and SECRET_KEY before regular use.
# Keep POSTGRES_PASSWORD URL-safe because it is interpolated into DATABASE_URL.
POSTGRES_USER=tau
POSTGRES_PASSWORD=replace-with-url-safe-password
POSTGRES_DB=tau_park
SECRET_KEY=replace-with-a-long-random-secret-key
TAU_FRONTEND_PORT=8080
TAU_DB_PORT=5433

